# If not running interactively, don't do anything
[ -z "$PS1" ] && return

# don't put duplicate lines or lines starting with space in the history.
# See bash(1) for more options
HISTCONTROL=ignoreboth

# append to the history file, don't overwrite it
shopt -s histappend

# If set, the pattern "**" used in a pathname expansion context will
# match all files and zero or more directories and subdirectories.
#shopt -s globstar

# make less more friendly for non-text input files, see lesspipe(1)
[ -x /usr/bin/lesspipe ] && eval "$(SHELL=/bin/sh lesspipe)"

# set variable identifying the chroot you work in (used in the prompt below)
if [ -z "$debian_chroot" ] && [ -r /etc/debian_chroot ]; then
    debian_chroot=$(cat /etc/debian_chroot)
fi

[[ -f ~/.bash_aliases ]] && source ~/.bash_aliases
[[ -f ~/.bash_prompt ]] && source ~/.bash_prompt
[[ -f ~/.bash_locale ]] && source ~/.bash_locale

export EDITOR=vim
export TZ=America/Toronto

vim_save() {
    find . -regex '.*swp' | sed 's|\.\([^\/]*\)\.swp|\1|' > open_vim_files.txt
    find . -regex '.*swp' | xargs rm
}

vim_load() {
    vim -p $(cat open_vim_files.txt)
}

# start tmux, maybe
which tmux >/dev/null && [[ -z $TMUX ]] && [[ -z $JETBRAINS_LICENSE_SERVER ]] && [[ $TERM_PROGRAM != "ghostty" ]] && tmux

PATH="$PATH:$HOME"
PATH=$PATH:~/go/bin/
PATH=$PATH:~/.local/bin
PATH="/opt/homebrew/bin:~/go/bin:$PATH"

# otherwise bundler would need to always be used with sudo to write to /var/lib
export GEM_HOME=$HOME/.gem

cd ~/Data/work

# zsh still has bugs
# example: run tmux or script under zsh, paste a string, and navigate with option+left
# Uncommend this to accept using bash and not get the nag.
# While this line is off, if you don't get the nag, you're on zsh.
# export BASH_SILENCE_DEPRECATION_WARNING=1

# bun completions
# generated via
#  $ bun completions bash
[ -s "/Users/amirkdv/.bun/_bun_bash" ] && source "/Users/amirkdv/.bun/_bun_bash"

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"
